// Linux x64 depot: everything under <ContentRoot>/linux/ lands in the install folder root.
"DepotBuild"
{
	"DepotID" "@DEPOT_LINUX@"
	"FileMapping"
	{
		"LocalPath" "linux/*"
		"DepotPath" "."
		"Recursive" "1"
	}
	// steam_appid.txt is only for local testing; Steam passes the app id itself
	"FileExclusion" "steam_appid.txt"
}
