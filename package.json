{
  "name": "dustup",
  "private": true,
  "version": "0.1.0",
  "description": "dustUP - a voxel sandboarding bullet-hell bounty hunt through a mythic Egyptian desert.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:admin": "VITE_ADMIN=1 vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "desktop:win": "node desktop/build.cjs --platforms=win32",
    "desktop:linux": "node desktop/build.cjs --platforms=linux",
    "desktop:all": "node desktop/build.cjs --platforms=win32,linux --smoke",
    "desktop:steam": "node desktop/build.cjs --platforms=win32,linux --steam",
    "desktop:admin": "node desktop/build.cjs --platforms=win32 --admin"
  },
  "dependencies": {
    "@fontsource/cinzel-decorative": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/rye": "^5.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/three": "^0.186.0",
    "electron": "45.2.1",
    "steamworks.js": "0.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  }
}
